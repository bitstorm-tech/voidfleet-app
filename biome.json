{
  "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": { "includes": ["**", "!**/bun.lock", "!client/assets"] },
  "formatter": { "indentStyle": "space", "lineWidth": 160 },
  "linter": {
    "rules": {
      "style": { "noNonNullAssertion": "off" },
      "correctness": { "noVoidTypeReturn": "off" },
      "suspicious": { "noAssignInExpressions": "off", "noFallthroughSwitchClause": "off" },
      "complexity": { "noImportantStyles": "off" }
    }
  },
  "css": { "linter": { "enabled": true } },
  "overrides": [{ "includes": ["**/*.css"], "linter": { "rules": { "style": { "noDescendingSpecificity": "off" } } } }]
}
